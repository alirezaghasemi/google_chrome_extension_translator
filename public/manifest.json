{
  "manifest_version": 3,
  "name": "Antigravity AI Translator & Screenshot",
  "version": "1.0.0",
  "description": "Production-grade AI webpage translation, technical term explanation, region translation, and full-page screenshot stitching powered by Gemini.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "contextMenus",
    "sidePanel",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://generativelanguage.googleapis.com/*"
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "pdf.worker.min.mjs",
        "pdf-viewer.html",
        "sidepanel.html",
        "snip.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*",
        "file://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "AI Translator & Screenshot",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "translate-page": {
      "suggested_key": {
        "default": "Alt+Shift+1",
        "windows": "Ctrl+Shift+1",
        "linux": "Ctrl+Shift+1",
        "mac": "Alt+Shift+1"
      },
      "description": "Translate current webpage"
    },
    "translate-region": {
      "suggested_key": {
        "default": "Alt+Shift+2",
        "windows": "Ctrl+Shift+2",
        "linux": "Ctrl+Shift+2",
        "mac": "Alt+Shift+2"
      },
      "description": "Select region to translate"
    },
    "capture-screenshot": {
      "suggested_key": {
        "default": "Alt+Shift+3",
        "windows": "Ctrl+Shift+3",
        "linux": "Ctrl+Shift+3",
        "mac": "Alt+Shift+3"
      },
      "description": "Capture visible viewport screenshot"
    },
    "capture-fullpage": {
      "suggested_key": {
        "default": "Alt+Shift+4",
        "windows": "Ctrl+Shift+4",
        "linux": "Ctrl+Shift+4",
        "mac": "Alt+Shift+4"
      },
      "description": "Capture full page screenshot"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
